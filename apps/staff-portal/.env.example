# Copy to .env and adjust. Vite only exposes variables prefixed VITE_ to the
# browser bundle — anything else stays server-side and is invisible to the app.
#
# WARNING: everything VITE_* is INLINED INTO THE PUBLIC BUNDLE at build time.
# Never put a secret here. Anyone can read it with view-source.

# Which API implementation the apps use.
#   mock — fixtures, no backend needed (default)
#   http — real calls to /api/v1/video
# video-service has no endpoints beyond health probes yet, so `http` will 404
# on every screen until they exist.
VITE_API_MODE=mock

# Where the dev server proxies /api. Only used by `npm run dev`; in production
# nginx handles it and this is ignored.
VITE_API_PROXY=http://localhost:8000

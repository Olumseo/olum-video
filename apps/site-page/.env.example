# Firebase — the SAME project and values as olum-frontend's VITE_FIREBASE_*.
# Used only by the sign-up form (/get-started) to verify phone and email.
# Leave unset in local development: `vite dev` then uses the Firebase Auth
# emulator (npm run firebase:emulator at the repo root) automatically.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# The sign-up API's origin, when it is NOT this site's own origin (e.g. on
# Vercel): https://olum.ai or wherever video-service is reachable over HTTPS.
# Leave unset on olum.ai (same origin) and locally (vite proxies /api).
VITE_API_URL=
